<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp"
              android:background="#C7D6CF">

    <!-- Title -->
    <TextView
            android:id="@+id/titleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chicago Style Pizza"
            android:textSize="24sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:background="#91B8B1"
            android:padding="10dp" />

    <!-- Spinner for Pizza Type -->
    <Spinner
            android:id="@+id/pizzaTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

    <!-- Radio Group for Sizes -->
    <RadioGroup
            android:id="@+id/sizeRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
        <RadioButton
                android:id="@+id/smallRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small" />
        <RadioButton
                android:id="@+id/mediumRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium" />
        <RadioButton
                android:id="@+id/largeRadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large" />
    </RadioGroup>

    <!-- Crust Text -->
    <TextView
            android:id="@+id/crustTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crust: Pan"
            android:textSize="16sp"
            android:layout_marginTop="10dp" />

    <!-- Pizza Image -->
    <ImageView
            android:id="@+id/pizzaImageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Pizza Image"
            android:scaleType="centerCrop" />

    <!-- RecyclerView for Available Toppings -->
    <TextView
            android:id="@+id/availableToppingsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Toppings"
            android:layout_marginTop="10dp" />
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/availableToppingsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp" />

    <!-- RecyclerView for Selected Toppings -->
    <TextView
            android:id="@+id/selectedToppingsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Toppings"
            android:layout_marginTop="10dp" />
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/selectedToppingsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="5dp" />

    <!-- Price -->
    <TextView
            android:id="@+id/priceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Price: $0.00"
            android:layout_marginTop="10dp" />

    <!-- Buttons -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
        <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Main" />
        <Button
                android:id="@+id/orderButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order"
                android:layout_marginLeft="10dp" />
    </LinearLayout>
</LinearLayout>
